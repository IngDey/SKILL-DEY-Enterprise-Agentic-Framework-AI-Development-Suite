# =============================================================
#  .env.example — COPIAR a .env y completar. NUNCA versionar .env
#  Cada variable: descripción · obligatoria(O)/opcional(o) · ejemplo
# =============================================================

# --- Aplicación ---
APP_NAME=MiApp                      # (O) nombre visible
APP_ENV=development                 # (O) development | test | staging | production
APP_PORT=3000                       # (O) puerto del backend
APP_URL=http://localhost:3000       # (O) URL pública del backend
FRONTEND_URL=http://localhost:5173  # (O) URL del frontend (CORS, correos)
APP_TIMEZONE=America/Bogota         # (O) zona horaria de presentación (BD guarda UTC)
APP_LOCALE=es-CO                    # (O) idioma/formato por defecto
LOG_LEVEL=info                      # (o) debug | info | warn | error

# --- Base de datos ---
DB_CLIENT=postgres                  # (O) postgres | mysql | mariadb | sqlserver | sqlite | mongodb
DB_HOST=localhost                   # (O)
DB_PORT=5432                        # (O)
DB_NAME=miapp                       # (O)
DB_USER=miapp                       # (O)
DB_PASSWORD=                        # (O) secreto
DB_SSL=false                        # (o)
DB_POOL_MIN=2                       # (o)
DB_POOL_MAX=10                      # (o)
# DATABASE_URL=                     # (o) alternativa a los campos anteriores

# --- Seguridad / Auth ---
JWT_SECRET=                         # (O) secreto largo aleatorio (openssl rand -hex 64)
JWT_EXPIRES_IN=15m                  # (O)
REFRESH_TOKEN_EXPIRES_IN=7d         # (O)
BCRYPT_ROUNDS=12                    # (o) o parámetros argon2
CORS_ORIGINS=http://localhost:5173  # (O) lista separada por comas
RATE_LIMIT_WINDOW_MS=60000          # (o)
RATE_LIMIT_MAX=100                  # (o)
LOGIN_MAX_ATTEMPTS=5                # (o)
SESSION_IDLE_TIMEOUT_MIN=30         # (o)

# --- Admin inicial (seed) ---
ADMIN_EMAIL=admin@example.com       # (O) solo para el seed inicial
ADMIN_PASSWORD=                     # (O) cambiar en el primer ingreso

# --- Caché / colas ---
REDIS_URL=                          # (o) redis://localhost:6379

# --- Correo ---
SMTP_HOST=                          # (o)
SMTP_PORT=587                       # (o)
SMTP_USER=                          # (o)
SMTP_PASSWORD=                      # (o) secreto
MAIL_FROM="MiApp <no-reply@example.com>"  # (o)

# --- Archivos ---
STORAGE_DRIVER=local                # (o) local | s3
STORAGE_PATH=./storage              # (o)
UPLOAD_MAX_MB=10                    # (o)
# S3_BUCKET= S3_REGION= S3_ACCESS_KEY= S3_SECRET_KEY= S3_ENDPOINT=

# --- Paginación / límites ---
PAGE_SIZE_DEFAULT=20                # (o)
PAGE_SIZE_MAX=100                   # (o)

# --- Observabilidad ---
SENTRY_DSN=                         # (o)

# --- Feature flags ---
FEATURE_REGISTRO_PUBLICO=false      # (o)
MAINTENANCE_MODE=false              # (o)

# --- Frontend (prefijo según framework: VITE_ / NEXT_PUBLIC_ / NG_) ---
VITE_API_URL=http://localhost:3000/api/v1  # (O) ¡solo valores públicos con prefijo!

# --- Pruebas automáticas de skill_dey (opcional) ---
# Usuario de PRUEBA (nunca uno real) para revisar las páginas que están tras el login
SKILL_DEY_TEST_USER=
SKILL_DEY_TEST_PASS=
